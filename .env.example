# Copy this file to .env (in this folder) and fill in the values. Never commit .env.

# The bot's token from @BotFather in Telegram: send /newbot, pick a name and a username
# ending in "bot", and BotFather replies with a token like 1234567890:AAH...
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id; only this user may use the bot.
# Find it by messaging @userinfobot in Telegram, or: put the token above in .env,
# send /start to your bot, then run `carousearch whoami`.
TELEGRAM_OWNER_ID=

# Optional. An Anthropic API key (console.anthropic.com) lets `carousearch search --screen` ask Claude Haiku
# for your variant's price in multi-item listings' descriptions; needs `pip install -e ".[llm]"`.
# Without it, screening still tags multi-item posts and keeps the listed price.
ANTHROPIC_API_KEY=
