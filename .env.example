# Copy this file to .env (in this folder) and fill in the values. Never commit .env.

# The bot's token from @BotFather in Telegram: send /newbot, pick a name and a username
# ending in "bot", and BotFather replies with a token like 1234567890:AAH...
TELEGRAM_BOT_TOKEN=

# Your own numeric Telegram user id; only this user may use the bot.
# Find it by messaging @userinfobot in Telegram, or: put the token above in .env,
# send /start to your bot, then run `carousearch whoami`.
TELEGRAM_OWNER_ID=

# --- Models: `carousearch ask`, the web app's Ask mode, and screening's price lookup ---
# Provider keys. Set the one your models need (the defaults below use OpenAI) and a monthly spend limit in the
# provider's console first. Without the key, ask refuses to start and screening keeps listed prices.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pydantic AI model strings, provider:model. The planner runs the agent loop; the worker answers the judge tools
# (judge_listings, judge_photos) and screening's price lookup. Defaults: openai:gpt-5.4-mini and openai:gpt-5.4-nano.
# Any other provider works too, e.g. anthropic:claude-haiku-5-5 (with ANTHROPIC_API_KEY).
AGENT_PLANNER_MODEL=
AGENT_WORKER_MODEL=
# Deprecated: AGENT_MODEL sets both of the above when they are empty. Prefer the two settings.
# AGENT_MODEL=

# Per-run caps (defaults 40, 15, 200 and 3). Calls beyond them are refused and the answer's notes say so.
# Tool calls include the Carousell requests the judge and photo tools make; 0 web searches turns web search off.
AGENT_MAX_TOOL_CALLS=
AGENT_MAX_PHOTOS=
AGENT_MAX_LISTINGS=
AGENT_MAX_WEB_SEARCHES=
# Restart `carousearch web` after changing any of these.
